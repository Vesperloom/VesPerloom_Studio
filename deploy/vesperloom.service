[Unit]
Description=Vesperloom image, motion and chat studio
After=network.target

[Service]
Type=simple
User=vesperloom
Group=vesperloom
WorkingDirectory=/opt/vesperloom
ExecStart=/usr/bin/node /opt/vesperloom/server/main.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=VESPER_HOME=/var/lib/vesperloom
EnvironmentFile=-/etc/vesperloom.env
StateDirectory=vesperloom
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
